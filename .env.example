# Nunca envie uma chave real para o Git.
# Opcoes: gemini, openai, openai_compatible.
LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
# Opcional: sem valor, usa o padrao do provedor.
FINRECON_MODEL=gemini-3.5-flash-lite
# Gemini only: perfil rapido para perguntas operacionais simples.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_SECONDS=45
# Para LLM_PROVIDER=openai, use OPENAI_API_KEY.
# Para LLM_PROVIDER=openai_compatible, use LLM_API_KEY e LLM_BASE_URL.
